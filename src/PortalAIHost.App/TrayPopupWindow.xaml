<Window
    x:Class="PortalAIHost.App.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="6">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <StackPanel Spacing="10" Padding="10">
            <TextBlock x:Name="HeaderText" Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind ViewModel.LinkLine, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLinkLine, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="TrayModelLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="TrayMemoryLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryLine, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="TrayLastLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastRequestLine, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="TrayQueueLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.QueueLine, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Border>
            </Grid>
            <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Live.ActionError, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.Live.HasActionError, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="TrayOpenButton" Command="{x:Bind ViewModel.OpenCommand}" />
                <Button x:Uid="TrayUnloadButton" Command="{x:Bind ViewModel.Live.UnloadCommand}"
                        Visibility="{x:Bind ViewModel.Live.CanUnload, Mode=OneWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Live.ActionPending, Mode=OneWay}" Width="18" Height="18"
                              Visibility="{x:Bind ViewModel.Live.ActionPending, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Live.PendingText, Mode=OneWay}" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.Live.ActionPending, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
