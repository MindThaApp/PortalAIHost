<Window
    x:Class="PortalAIHost.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Automation">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="AppMenuButton" x:Uid="AppMenuButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" CornerRadius="4">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" Width="24" Height="24" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Uid="MenuSettings" Tag="settings" Click="OnMenuPage" KeyboardAcceleratorTextOverride="Ctrl+,">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuShortcuts" Click="OnMenuShortcuts">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuWhatsNew" Tag="whatsnew" Click="OnMenuPage">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE789;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuAbout" Tag="about" Click="OnMenuPage" KeyboardAcceleratorTextOverride="F1">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Help" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" IsHitTestVisible="False" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavHome" Tag="home" Icon="Home" />
                <NavigationViewItem x:Uid="NavModels" Tag="models" Icon="Download" />
                <NavigationViewItem x:Uid="NavApps" Tag="apps" Icon="Contact" />
                <NavigationViewItem x:Uid="NavDevices" Tag="devices" Icon="TwoPage" />
                <NavigationViewItem x:Uid="NavTryIt" Tag="tryit" Icon="Message" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="settings" Icon="Setting" />
                <NavigationViewItem x:Uid="NavAbout" Tag="about" Icon="Help" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
            <InfoBar x:Name="UpdateBar" x:Uid="UpdateBar" Severity="Informational" IsOpen="False" IsClosable="True"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="460"
                     Closed="OnUpdateBarClosed">
                <InfoBar.ActionButton>
                    <Button x:Uid="UpdateButton" Click="OnUpdateClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                            <TextBlock x:Uid="UpdateButtonText" />
                        </StackPanel>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Window>
