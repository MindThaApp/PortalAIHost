<Window
    x:Class="PortalAIHost.App.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero: the app logo and a greeting. -->
        <StackPanel Grid.Row="0" Padding="32,24,32,8" Spacing="8" HorizontalAlignment="Center">
            <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="72" Height="72" HorizontalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="HeroTitle" x:Uid="WelcomeTitle" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <Grid Padding="48,8,48,8" MaxWidth="720">
                <!-- Step 1: what it does -->
                <StackPanel x:Name="Panel0" Spacing="16" Visibility="{x:Bind ViewModel.OnWelcome, Mode=OneWay}">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <TextBlock x:Name="Head0" x:Uid="WelcomeLead" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="WelcomeIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="WelcomePoint1Title" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomePoint1Body" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="WelcomePoint2Title" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomePoint2Body" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                            <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="WelcomePoint3Title" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomePoint3Body" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Step 2: pick a model -->
                <StackPanel x:Name="Panel1" Spacing="12" Visibility="{x:Bind ViewModel.OnModel, Mode=OneWay}">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <TextBlock x:Name="Head1" x:Uid="WelcomeModelTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="WelcomeModelIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="8">
                            <!-- Checking your PC -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.Checking, Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind ViewModel.Checking, Mode=OneWay}" Width="20" Height="20" />
                                <TextBlock Text="{x:Bind ViewModel.MemoryLine, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- The recommended model -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasModel, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ModelReason, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ModelSize, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ExistingLine, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Uid="WelcomeNoModel" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowNoModel, Mode=OneWay}" />
                            <!-- Download choice -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.ShowOffer, Mode=OneWay}">
                                <Button x:Name="DownloadButton" x:Uid="WelcomeDownload" Command="{x:Bind ViewModel.DownloadCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Uid="WelcomeChooseLater" Command="{x:Bind ViewModel.NextCommand}" />
                            </StackPanel>
                            <!-- Download progress -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}">
                                <ProgressBar Value="{x:Bind ViewModel.Percent, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Uid="WelcomeKeepGoing" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Uid="WelcomeRetry" Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasModel, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.MemoryLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasModel, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.GraphicsLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.DiskLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 3: where to find it -->
                <StackPanel x:Name="Panel2" Spacing="16" Visibility="{x:Bind ViewModel.OnWhere, Mode=OneWay}">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <TextBlock x:Name="Head2" x:Uid="WelcomeWhereTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                            <FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="WelcomeTrayTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomeTrayBody" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="WelcomeAskTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomeAskBody" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch x:Name="StartupToggle" x:Uid="WelcomeStartWithWindows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=OneWay}" Toggled="OnStartupToggled" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Step dots -->
        <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,8">
            <Ellipse Width="8" Height="8" /><Ellipse Width="8" Height="8" /><Ellipse Width="8" Height="8" />
        </StackPanel>

        <!-- Skip on the left, Back and Next on the right -->
        <Grid Grid.Row="3" Padding="32,8,32,24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton x:Name="SkipButton" x:Uid="WelcomeSkip" Command="{x:Bind ViewModel.SkipCommand}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" x:Uid="WelcomeBack" Command="{x:Bind ViewModel.BackCommand}" Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
                <Button x:Name="NextButton" Command="{x:Bind ViewModel.NextCommand}" Content="{x:Bind ViewModel.NextText, Mode=OneWay}" MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Bind ViewModel.NextText, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
