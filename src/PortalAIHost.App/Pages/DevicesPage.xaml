<Page
    x:Class="PortalAIHost.App.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="DevicesTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="DevicesGamingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="DevicesGamingText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GamingStatusText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" MinHeight="20" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Uid="DevicesGaming" IsOn="{x:Bind ViewModel.GamingMode, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Left" Width="28" Height="28" />
            <TextBlock x:Uid="DevicesNone" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceCardViewModel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind StatusText, Mode=OneWay}" /><Run Text=" - " /><Run Text="{x:Bind RouteText, Mode=OneWay}" /><Run Text=" - " /><Run Text="{x:Bind LastSeenText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Command="{x:Bind TogglePauseCommand}" AutomationProperties.Name="{x:Bind PauseAutomation, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PauseTip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE769;" FontSize="14" />
                                                <TextBlock Text="{x:Bind PauseLabel, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Uid="DevicesForget" Command="{x:Bind ForgetCommand}" AutomationProperties.Name="{x:Bind ForgetAutomation, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                <TextBlock x:Uid="DevicesForgetLabel" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceAppRow">
                                            <Grid ColumnSpacing="12" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind TodayText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ActiveText, Mode=OneWay}" MinHeight="20" />
                                                </StackPanel>
                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Bars, Mode=OneWay}" VerticalAlignment="Bottom">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DayBar">
                                                            <Border Width="8" Height="{x:Bind Height}" VerticalAlignment="Bottom" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.Name="{x:Bind Automation}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Grid.Column="2" Command="{x:Bind TogglePauseCommand}" AutomationProperties.Name="{x:Bind PauseAutomation, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PauseTip, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE769;" FontSize="14" />
                                                        <TextBlock Text="{x:Bind PauseLabel, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ModelText, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind LoadedByText, Mode=OneWay}" MinHeight="20" />
                                    <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Uid="DevicesTakeBack" Command="{x:Bind TakeBackCommand}" Visibility="{x:Bind HasLoaded, Mode=OneWay}" AutomationProperties.Name="{x:Bind TakeBackAutomation, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                                            <TextBlock x:Uid="DevicesTakeBackLabel" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="DevicesRename">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            <TextBlock x:Uid="DevicesRenameLabel" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8" Width="260">
                                                    <TextBox x:Uid="DevicesNewName" Text="{x:Bind NewName, Mode=TwoWay}" MaxLength="64" />
                                                    <Button x:Uid="DevicesRenameSave" Command="{x:Bind RenameCommand}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Uid="DevicesLimits">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                                            <TextBlock x:Uid="DevicesLimitsLabel" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10" Width="300">
                                                    <ToggleSwitch x:Uid="DevicesPriorityEqual" IsOn="{x:Bind PriorityEqual, Mode=TwoWay}" />
                                                    <NumberBox x:Uid="DevicesRequestLimit" Value="{x:Bind RequestLimit, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Hidden" PlaceholderText="-" />
                                                    <NumberBox x:Uid="DevicesTokenLimit" Value="{x:Bind TokenLimit, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Hidden" PlaceholderText="-" />
                                                    <ToggleSwitch x:Uid="DevicesQuiet" IsOn="{x:Bind QuietEnabled, Mode=TwoWay}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TimePicker x:Uid="DevicesQuietFrom" IsEnabled="{x:Bind QuietEnabled, Mode=OneWay}" Time="{x:Bind QuietStart, Mode=TwoWay}" ClockIdentifier="24HourClock" />
                                                        <TimePicker x:Uid="DevicesQuietTo" IsEnabled="{x:Bind QuietEnabled, Mode=OneWay}" Time="{x:Bind QuietEnd, Mode=TwoWay}" ClockIdentifier="24HourClock" />
                                                    </StackPanel>
                                                    <TextBlock x:Uid="DevicesModelsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <ItemsControl ItemsSource="{x:Bind Models}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ModelChoice">
                                                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Allowed, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button x:Uid="DevicesSave" Command="{x:Bind SaveSettingsCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                            <TextBlock x:Uid="DevicesSaveLabel" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
