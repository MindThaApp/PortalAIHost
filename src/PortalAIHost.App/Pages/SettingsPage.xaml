<Page
    x:Class="PortalAIHost.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar
                x:Name="ResultBar"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                IsClosable="False" />

            <Grid>
                <TextBlock x:Uid="SettingsGeneralHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="SettingsResetGeneral" Command="{x:Bind ViewModel.ResetGeneralCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <ToggleSwitch
                        x:Uid="SettingsStartWithWindows"
                        IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.StartupChangeable, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StartupNote, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox
                        x:Uid="SettingsIdle"
                        ItemsSource="{x:Bind ViewModel.IdleChoices}"
                        SelectedIndex="{x:Bind ViewModel.IdleIndex, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}"
                        MinWidth="260" />
                    <TextBlock x:Uid="SettingsIdleHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="PerformanceHeader">
                <TextBlock x:Uid="SettingsPerformanceHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="SettingsResetPerformance" Command="{x:Bind ViewModel.ResetPerformanceCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource CardBorder}">
                <ContentControl IsEnabled="{x:Bind ViewModel.PerformanceAvailable, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <InfoBar
                        x:Name="PerformanceResultBar"
                        IsOpen="{x:Bind ViewModel.HasPerformanceMessage, Mode=OneWay}"
                        Message="{x:Bind ViewModel.PerformanceMessage, Mode=OneWay}"
                        IsClosable="False" />

                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Uid="SettingsPreset"
                            ItemsSource="{x:Bind ViewModel.PresetChoices}"
                            SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}"
                            MinWidth="260" />
                        <TextBlock Text="{x:Bind ViewModel.PresetHelp, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Slider
                            x:Uid="SettingsMemory"
                            Minimum="{x:Bind ViewModel.MemoryMinGb, Mode=OneWay}"
                            Maximum="{x:Bind ViewModel.MemoryMaxGb, Mode=OneWay}"
                            Value="{x:Bind ViewModel.MemoryGb, Mode=TwoWay}"
                            StepFrequency="1" SmallChange="1" LargeChange="4" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryRangeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="SettingsMemoryHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Slider
                            x:Uid="SettingsKeepFree"
                            Minimum="{x:Bind ViewModel.KeepFreeMinGb, Mode=OneWay}"
                            Maximum="{x:Bind ViewModel.KeepFreeMaxGb, Mode=OneWay}"
                            Value="{x:Bind ViewModel.KeepFreeGb, Mode=TwoWay}"
                            StepFrequency="1" SmallChange="1" LargeChange="4" />
                        <TextBlock Text="{x:Bind ViewModel.KeepFreeLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="SettingsKeepFreeHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Uid="SettingsRunOn"
                            ItemsSource="{x:Bind ViewModel.RunOnChoices}"
                            SelectedIndex="{x:Bind ViewModel.RunOnIndex, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.RunOnEnabled, Mode=OneWay}"
                            MinWidth="260" />
                        <TextBlock Text="{x:Bind ViewModel.RunOnHelp, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GpuNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasGpuNote, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.GpuMemoryVisible, Mode=OneWay}">
                        <Slider
                            x:Uid="SettingsGpuMemory"
                            Minimum="{x:Bind ViewModel.GpuMemoryMinGb, Mode=OneWay}"
                            Maximum="{x:Bind ViewModel.GpuMemoryMaxGb, Mode=OneWay}"
                            Value="{x:Bind ViewModel.GpuMemoryGb, Mode=TwoWay}"
                            StepFrequency="0.5" SmallChange="0.5" LargeChange="2" />
                        <TextBlock Text="{x:Bind ViewModel.GpuMemoryLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Slider
                            x:Uid="SettingsCores"
                            Minimum="{x:Bind ViewModel.CoresMin, Mode=OneWay}"
                            Maximum="{x:Bind ViewModel.CoresMax, Mode=OneWay}"
                            Value="{x:Bind ViewModel.CoresValue, Mode=TwoWay}"
                            StepFrequency="1" SmallChange="1" LargeChange="2" />
                        <TextBlock Text="{x:Bind ViewModel.CoresLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="SettingsCoresHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Uid="SettingsPriority"
                            ItemsSource="{x:Bind ViewModel.PriorityChoices}"
                            SelectedIndex="{x:Bind ViewModel.PriorityIndex, Mode=TwoWay}"
                            MinWidth="260" />
                        <TextBlock Text="{x:Bind ViewModel.PriorityHelp, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Slider
                            x:Uid="SettingsCeiling"
                            Minimum="20" Maximum="100"
                            Value="{x:Bind ViewModel.CeilingValue, Mode=TwoWay}"
                            StepFrequency="5" SmallChange="5" LargeChange="10" />
                        <TextBlock Text="{x:Bind ViewModel.CeilingLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="SettingsCeilingHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="SettingsEaseOffHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <CheckBox x:Uid="SettingsEaseOffFullscreen" IsChecked="{x:Bind ViewModel.EaseOffFullscreen, Mode=TwoWay}" />
                        <CheckBox x:Uid="SettingsEaseOffBattery" IsChecked="{x:Bind ViewModel.EaseOffBattery, Mode=TwoWay}" />
                        <CheckBox x:Uid="SettingsEaseOffAppBusy" IsChecked="{x:Bind ViewModel.EaseOffAppBusy, Mode=TwoWay}" />
                        <TextBlock x:Uid="SettingsEaseOffHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.FitText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasFit, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                </ContentControl>
            </Border>

            <Grid>
                <TextBlock x:Uid="SettingsNotificationsHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="SettingsResetNotifications" Command="{x:Bind ViewModel.ResetNotificationsCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="SettingsNotificationsHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Uid="SettingsNotifyDownloads" IsOn="{x:Bind ViewModel.NotifyDownloads, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                    <ToggleSwitch x:Uid="SettingsNotifyApprovals" IsOn="{x:Bind ViewModel.NotifyApprovals, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                    <ToggleSwitch x:Uid="SettingsNotifyProblems" IsOn="{x:Bind ViewModel.NotifyProblems, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock x:Uid="SettingsRemoteHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Uid="SettingsRemoteEnabled" IsOn="{x:Bind ViewModel.RemoteEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                    <TextBlock x:Uid="SettingsRemoteHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasRemoteProblem, Mode=OneWay}" Message="{x:Bind ViewModel.RemoteProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" />
                    <TextBlock Text="{x:Bind ViewModel.RemoteAddressText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ToggleSwitch x:Uid="SettingsRemoteRelay" IsOn="{x:Bind ViewModel.RemoteRelay, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.RemoteEnabled, Mode=OneWay}" />
                    <TextBlock x:Uid="SettingsRemoteRelayHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Uid="SettingsRelayAdmission" IsOn="{x:Bind ViewModel.RelayAdmission, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.RemoteRelay, Mode=OneWay}" />
                    <TextBlock x:Uid="SettingsRelayAdmissionHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Uid="SettingsRotateRelayKey" Command="{x:Bind ViewModel.RotateRelayKeyCommand}" IsEnabled="{x:Bind ViewModel.RelayAdmission, Mode=OneWay}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock x:Uid="SettingsRotateRelayKeyText" />
                        </StackPanel>
                    </Button>
                    <ToggleSwitch x:Uid="SettingsAllowReplace" IsOn="{x:Bind ViewModel.AllowReplaceModels, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.RemoteEnabled, Mode=OneWay}" />
                    <TextBlock x:Uid="SettingsAllowReplaceHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.RelayStatusText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button x:Uid="SettingsPairDevice" Command="{x:Bind ViewModel.PairDeviceCommand}" IsEnabled="{x:Bind ViewModel.RemoteEnabled, Mode=OneWay}" HorizontalAlignment="Left" />

                    <StackPanel x:Name="PairingPanel" Spacing="8" Visibility="{x:Bind ViewModel.PairingOpen, Mode=OneWay}">
                        <TextBlock x:Uid="SettingsPairingSteps" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PairingCode, Mode=OneWay}" FontSize="36" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                        <Image x:Name="PairingQr" x:Uid="SettingsPairingQr" Width="220" Height="220" HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind ViewModel.PairingAddressText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <Button x:Uid="SettingsPairingCopyLink" Click="OnCopyPairingLink" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                <TextBlock x:Uid="SettingsPairingCopyLinkText" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.PairingExpiryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PairingFingerprintText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <Button x:Uid="SettingsPairingCancel" Command="{x:Bind ViewModel.CancelPairingCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock x:Uid="SettingsDevicesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsNoDevices" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.NoDevices, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceRow">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind LastSeenText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ToggleSwitch x:Uid="SettingsDeviceModelControl" IsOn="{x:Bind ModelControl}" Tag="{x:Bind DeviceId}" Toggled="OnModelControlToggled"
                                                      AutomationProperties.Name="{x:Bind ModelControlAutomation}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HasLoaded}">
                                            <TextBlock Text="{x:Bind LoadedByText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button x:Uid="SettingsTakeBack" Tag="{x:Bind TakeBackKind}" Click="OnTakeBack" AutomationProperties.Name="{x:Bind TakeBackAutomation}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                                    <TextBlock x:Uid="SettingsTakeBackLabel" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Uid="SettingsRemoveDevice" Tag="{x:Bind DeviceId}" Click="OnRemoveDevice"
                                            AutomationProperties.Name="{x:Bind RemoveAutomation}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock x:Uid="SettingsPrivacyHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="SettingsResetPrivacy" Command="{x:Bind ViewModel.ResetPrivacyCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Uid="SettingsCrashReports" IsOn="{x:Bind ViewModel.SendCrashReports, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsCrashReportsHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="CrashWhatsSent" x:Uid="CrashWhatsSent" Padding="0,4" />
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock x:Uid="SettingsModelsHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="SettingsResetFolder" Command="{x:Bind ViewModel.ResetFolderCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBox
                        x:Name="FolderBox"
                        x:Uid="SettingsFolder"
                        Text="{x:Bind ViewModel.ModelsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Bind ViewModel.FolderPlaceholder, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}"
                        LostFocus="OnFolderLostFocus"
                        KeyDown="OnFolderKeyDown" />
                    <TextBlock x:Uid="SettingsFolderHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.MoveOfferVisible, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.MoveOfferText, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="SettingsMoveButton" Command="{x:Bind ViewModel.MoveCommand}" IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="SettingsMoveCancel" Command="{x:Bind ViewModel.CancelMoveCommand}" Visibility="{x:Bind ViewModel.Moving, Mode=OneWay}" />
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.MovePercent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.Moving, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8" Visibility="{x:Bind AppModels.Available, Mode=OneWay}">
                <TextBlock x:Uid="SettingsAppModelsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <InfoBar IsOpen="{x:Bind AppModels.HasMessage, Mode=OneWay}" Severity="Warning" Message="{x:Bind AppModels.Message, Mode=OneWay}" IsClosable="False" />
                        <TextBlock x:Uid="SettingsAppModelsHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind AppModels.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppModelRowViewModel">
                                    <Grid ColumnSpacing="16" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{x:Bind Choices}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Automation}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid>
                <TextBlock x:Uid="SettingsAppearanceHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton x:Uid="SettingsResetAppearance" Command="{x:Bind ViewModel.ResetAppearanceCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <ComboBox x:Uid="SettingsTheme" ItemsSource="{x:Bind ViewModel.ThemeChoices}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="260" />
                    <ComboBox x:Uid="SettingsMaterial" ItemsSource="{x:Bind ViewModel.MaterialChoices}" SelectedIndex="{x:Bind ViewModel.MaterialIndex, Mode=TwoWay}" MinWidth="260" />
                    <ComboBox x:Uid="SettingsCorners" ItemsSource="{x:Bind ViewModel.CornerChoices}" SelectedIndex="{x:Bind ViewModel.CornersIndex, Mode=TwoWay}" MinWidth="260" />
                    <ComboBox x:Uid="SettingsDensity" ItemsSource="{x:Bind ViewModel.DensityChoices}" SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}" MinWidth="260" />
                    <ComboBox x:Uid="SettingsTextSize" ItemsSource="{x:Bind ViewModel.TextChoices}" SelectedIndex="{x:Bind ViewModel.TextIndex, Mode=TwoWay}" MinWidth="260" />
                    <ComboBox x:Uid="SettingsMotion" ItemsSource="{x:Bind ViewModel.MotionChoices}" SelectedIndex="{x:Bind ViewModel.MotionIndex, Mode=TwoWay}" MinWidth="260" />
                    <TextBlock x:Uid="SettingsAppearanceHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
