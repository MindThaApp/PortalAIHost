<Page
    x:Class="PortalAIHost.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <ToggleSwitch
                        x:Uid="SettingsStartWithWindows"
                        IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                    <ComboBox
                        x:Uid="SettingsIdle"
                        ItemsSource="{x:Bind ViewModel.IdleChoices}"
                        SelectedIndex="{x:Bind ViewModel.IdleIndex, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}"
                        MinWidth="260" />
                    <TextBlock x:Uid="SettingsIdleHelp" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBox
                        x:Uid="SettingsFolder"
                        Text="{x:Bind ViewModel.ModelsFolder, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                    <Button
                        x:Uid="SettingsFolderApply"
                        Command="{x:Bind ViewModel.ApplyFolderCommand}"
                        IsEnabled="{x:Bind ViewModel.Available, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
