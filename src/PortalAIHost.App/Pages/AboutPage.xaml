<Page
    x:Class="PortalAIHost.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="AboutTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.VersionLine}" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.LicenceState}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Uid="AboutCopyVersion" Command="{x:Bind ViewModel.CopyVersionCommand}" />
                        <Button x:Uid="AboutWhatsNew" Click="OnWhatsNew" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CopyNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <TextBlock x:Uid="AboutHelpHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="4">
                    <HyperlinkButton x:Name="FeedbackLink" x:Uid="AboutFeedback" Padding="0,4" />
                    <HyperlinkButton x:Name="PrivacyLink" x:Uid="AboutPrivacy" Padding="0,4" />
                    <HyperlinkButton x:Name="DataFolderLink" x:Uid="AboutDataFolder" Click="OnOpenDataFolder" Padding="0,4" />
                </StackPanel>
            </Border>

            <TextBlock x:Uid="AboutLicencesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.ThirdParty}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <HyperlinkButton x:Name="LlamaLink" x:Uid="AboutLlamaLink" Padding="0,4" />
                    <Expander x:Uid="AboutLlamaExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="{x:Bind ViewModel.LlamaLicence}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
