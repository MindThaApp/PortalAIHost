<Page
    x:Class="PortalAIHost.App.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="CleanupItemTemplate" x:DataType="vm:CleanupItemViewModel">
            <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
        <DataTemplate x:Key="RemoteModelRowTemplate" x:DataType="vm:RemoteModelRowViewModel">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind LoadedByText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Uid="RemoteModelTooBig" Visibility="{x:Bind TooBig, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MinWidth="150">
                        <ComboBox x:Uid="RemoteModelPlacement" ItemsSource="{x:Bind PlacementChoices}" SelectedIndex="{x:Bind PlacementIndex, Mode=TwoWay}" IsEnabled="{x:Bind CanLoad, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="RemoteModelLoad" AutomationProperties.Name="{x:Bind AutoLoad, Mode=OneWay}" Command="{x:Bind LoadCommand}" Visibility="{x:Bind CanLoad, Mode=OneWay}" IsEnabled="{x:Bind Idle, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Uid="RemoteModelLoadLabel" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="RemoteModelUnload" AutomationProperties.Name="{x:Bind AutoUnload, Mode=OneWay}" Command="{x:Bind UnloadCommand}" Visibility="{x:Bind CanUnload, Mode=OneWay}" IsEnabled="{x:Bind Idle, Mode=OneWay}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock x:Uid="RemoteModelUnloadLabel" />
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Busy, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ModelRowTemplate" x:DataType="vm:ModelRowViewModel">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Badge, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind QualityText}" AutomationProperties.Name="{x:Bind QualityName}" />
                            <TextBlock Text="{x:Bind LastUsedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Uid="ModelTooBig" Visibility="{x:Bind TooBig, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind VramText}" Visibility="{x:Bind HasVram}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ShowProgress, Mode=OneWay}" IsIndeterminate="{x:Bind Removing, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" Visibility="{x:Bind ShowProgress, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind CheckPercent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind Checking, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind CheckText, Mode=OneWay}" Visibility="{x:Bind HasCheckText, Mode=OneWay}" TextWrapping="Wrap" />
                        <Expander x:Uid="ModelDetails" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind AdviceText}" Visibility="{x:Bind HasAdvice}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind QualityName}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind SizeText}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind MemoryText}" Visibility="{x:Bind HasMemory}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="{x:Bind LicenceText}" NavigateUri="{x:Bind LicenceUri}" Visibility="{x:Bind HasLicence}" Padding="0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MinWidth="130">
                        <Button x:Uid="ModelDownload" AutomationProperties.Name="{x:Bind AutoDownload}" Command="{x:Bind DownloadCommand}" Visibility="{x:Bind CanDownload, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="ModelPause" AutomationProperties.Name="{x:Bind AutoPause}" Command="{x:Bind PauseCommand}" Visibility="{x:Bind CanPause, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="ModelResume" AutomationProperties.Name="{x:Bind AutoResume}" Command="{x:Bind ResumeCommand}" Visibility="{x:Bind CanResume, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="ModelCancel" AutomationProperties.Name="{x:Bind AutoCancel}" Command="{x:Bind CancelCommand}" Visibility="{x:Bind CanCancel, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="ModelUse" AutomationProperties.Name="{x:Bind AutoUse}" Command="{x:Bind ActivateCommand}" Visibility="{x:Bind CanActivate, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="ModelRedownload" AutomationProperties.Name="{x:Bind AutoRedownload}" Command="{x:Bind RedownloadCommand}" Visibility="{x:Bind CanRedownload, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="ModelCheck" AutomationProperties.Name="{x:Bind AutoCheck}" Command="{x:Bind CheckCommand}" Visibility="{x:Bind CanCheck, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="ModelCancelCheck" Command="{x:Bind CancelCheckCommand}" Visibility="{x:Bind Checking, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button x:Uid="ModelRemove" AutomationProperties.Name="{x:Bind AutoRemove}" Command="{x:Bind RemoveCommand}" Visibility="{x:Bind CanRemove, Mode=OneWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ModelChipTemplate" x:DataType="vm:ModelCategoryChip">
            <ToggleButton IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Tooltip}" ToolTipService.ToolTip="{x:Bind Tooltip}" MinWidth="88">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                    <TextBlock Text="{x:Bind Label}" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>
        <DataTemplate x:Key="ModelGroupTemplate" x:DataType="vm:ModelGroupViewModel">
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ModelRowTemplate}" />
                <Button Command="{x:Bind ToggleAllCommand}" Visibility="{x:Bind CanToggle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToggleText, Mode=OneWay}" AutomationProperties.Name="{x:Bind ToggleText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                        <TextBlock Text="{x:Bind ToggleText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Uid="ModelsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <ProgressRing IsActive="True" Width="20" Height="20" HorizontalAlignment="Left" Opacity="{x:Bind Budget.PlaceholderOpacity, Mode=OneWay}" />
                    <StackPanel Spacing="8" Opacity="{x:Bind Budget.BarOpacity, Mode=OneWay}">
                        <TextBlock x:Uid="ModelsMemoryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Budget.Ram.Text, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <Grid>
                                <ProgressBar Value="{x:Bind Budget.Ram.ReservedEndPercent, Mode=OneWay}" Maximum="100" Opacity="0.45" />
                                <ProgressBar Value="{x:Bind Budget.Ram.UsedPercent, Mode=OneWay}" Maximum="100" Background="Transparent" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="2" Visibility="{x:Bind Budget.Vram.Visible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Budget.Vram.Text, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <Grid>
                                <ProgressBar Value="{x:Bind Budget.Vram.ReservedEndPercent, Mode=OneWay}" Maximum="100" Opacity="0.45" />
                                <ProgressBar Value="{x:Bind Budget.Vram.UsedPercent, Mode=OneWay}" Maximum="100" Background="Transparent" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.ErrorLine, Mode=OneWay}" TextWrapping="Wrap" />
            <InfoBar
                x:Uid="ModelsRemoveFailedBar"
                Severity="Error"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasRemoveFailure, Mode=TwoWay}"
                Message="{x:Bind ViewModel.RemoveFailure, Mode=OneWay}" />
            <InfoBar
                x:Uid="ModelsCatalogueBar"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.CatalogueUnavailable, Mode=OneWay}" />
            <InfoBar
                x:Uid="ModelsExistingBar"
                Severity="Success"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasExisting, Mode=OneWay}"
                Message="{x:Bind ViewModel.ExistingCopyLine, Mode=OneWay}" />
            <InfoBar
                x:Uid="ModelsUpgradeBar"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasUpgrade, Mode=OneWay}"
                Message="{x:Bind ViewModel.UpgradeLine, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.StorageLine, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="ModelsOpenFolder" Command="{x:Bind ViewModel.OpenFolderCommand}" IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}" />
                        <Button x:Uid="ModelsFreeUp" Command="{x:Bind ViewModel.FreeUpSpaceCommand}" />
                        <Button x:Uid="ModelsAddOwn" Command="{x:Bind ViewModel.AddOwnModelCommand}" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.StoreBusyPercent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.StoreBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StoreBusyLine, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button x:Uid="ModelsMoveCancel" Command="{x:Bind ViewModel.CancelMoveCommand}" Visibility="{x:Bind ViewModel.StoreBusy, Mode=OneWay}" />
                    <TextBlock x:Uid="ModelsAddOwnHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="ModelsMoveHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CleanupOpen, Mode=OneWay}">
                        <TextBlock x:Uid="ModelsCleanupTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CleanupLine, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CleanupHasPartial, Mode=OneWay}">
                            <TextBlock x:Uid="ModelsCleanupPartialHeader" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CleanupPartial}" ItemTemplate="{StaticResource CleanupItemTemplate}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CleanupHasOld, Mode=OneWay}">
                            <TextBlock x:Uid="ModelsCleanupOldHeader" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CleanupOld}" ItemTemplate="{StaticResource CleanupItemTemplate}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CleanupHasDamaged, Mode=OneWay}">
                            <TextBlock x:Uid="ModelsCleanupDamagedHeader" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CleanupDamaged}" ItemTemplate="{StaticResource CleanupItemTemplate}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.CleanupButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ConfirmCleanupCommand}" IsEnabled="{x:Bind ViewModel.CanCleanup, Mode=OneWay}" Visibility="{x:Bind ViewModel.CleanupHasItems, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="ModelsCleanupClose" Command="{x:Bind ViewModel.CloseCleanupCommand}" />
                        </StackPanel>
                        <TextBlock x:Uid="ModelsCleanupHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8" Visibility="{x:Bind Remote.IsClientMode, Mode=OneWay}">
                <TextBlock Text="{x:Bind Remote.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Link.ChipText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                <InfoBar Severity="Informational" IsClosable="False" Message="{x:Bind Link.UsingLaptopText, Mode=OneWay}" IsOpen="{x:Bind Link.UsingLaptopModel, Mode=OneWay}" />
                <InfoBar Severity="Warning" IsClosable="False" Message="{x:Bind Link.AttentionText, Mode=OneWay}" IsOpen="{x:Bind Link.NeedsAttention, Mode=OneWay}" />
                <TextBlock x:Uid="ModelsLocalNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar IsOpen="{x:Bind Remote.HasMessage, Mode=OneWay}" Severity="Warning" Message="{x:Bind Remote.Message, Mode=OneWay}" IsClosable="False" />
                <ProgressRing IsActive="{x:Bind Remote.IsLoading, Mode=OneWay}" Visibility="{x:Bind Remote.IsLoading, Mode=OneWay}" HorizontalAlignment="Left" Width="28" Height="28" />
                <TextBlock Text="{x:Bind Remote.EmptyText, Mode=OneWay}" Visibility="{x:Bind Remote.ShowEmpty, Mode=OneWay}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind Remote.Rows}" ItemTemplate="{StaticResource RemoteModelRowTemplate}" Opacity="{x:Bind Remote.ListOpacity, Mode=OneWay}">
                    <ItemsControl.OpacityTransition>
                        <ScalarTransition />
                    </ItemsControl.OpacityTransition>
                </ItemsControl>
            </StackPanel>

            <TextBox x:Uid="ModelsSearch" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chips}" ItemTemplate="{StaticResource ModelChipTemplate}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="104" MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="None" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            <TextBlock x:Uid="ModelsNoMatches" Visibility="{x:Bind ViewModel.NoMatches, Mode=OneWay}" TextWrapping="Wrap" />

            <TextBlock x:Uid="ModelsDownloadedHeader" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="{x:Bind ViewModel.HasDownloadedShown, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.DownloadedShown}" ItemTemplate="{StaticResource ModelRowTemplate}" />

            <TextBlock x:Uid="ModelsMoreHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" ItemTemplate="{StaticResource ModelGroupTemplate}" />
        </StackPanel>
    </ScrollViewer>
</Page>
