<Page
    x:Class="PortalAIHost.App.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Uid="ModelsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorLine, Mode=OneWay}" TextWrapping="Wrap" />
            <InfoBar
                x:Uid="ModelsExistingBar"
                Severity="Success"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasExisting, Mode=OneWay}"
                Message="{x:Bind ViewModel.ExistingCopyLine, Mode=OneWay}" />
            <InfoBar
                x:Uid="ModelsUpgradeBar"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasUpgrade, Mode=OneWay}"
                Message="{x:Bind ViewModel.UpgradeLine, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Models}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModelRowViewModel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Badge, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Opacity="0.8" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind SizeText}" Opacity="0.8" />
                                        <TextBlock Text="{x:Bind QualityText}" AutomationProperties.Name="{x:Bind QualityName}" />
                                    </StackPanel>
                                    <TextBlock x:Uid="ModelTooBig" Visibility="{x:Bind TooBig, Mode=OneWay}" TextWrapping="Wrap" />
                                    <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" Visibility="{x:Bind ShowProgress, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MinWidth="130">
                                    <Button x:Uid="ModelDownload" AutomationProperties.Name="{x:Bind AutoDownload}" Command="{x:Bind DownloadCommand}" Visibility="{x:Bind CanDownload, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Uid="ModelPause" AutomationProperties.Name="{x:Bind AutoPause}" Command="{x:Bind PauseCommand}" Visibility="{x:Bind CanPause, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                    <Button x:Uid="ModelResume" AutomationProperties.Name="{x:Bind AutoResume}" Command="{x:Bind ResumeCommand}" Visibility="{x:Bind CanResume, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                    <Button x:Uid="ModelCancel" AutomationProperties.Name="{x:Bind AutoCancel}" Command="{x:Bind CancelCommand}" Visibility="{x:Bind CanCancel, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                    <Button x:Uid="ModelUse" AutomationProperties.Name="{x:Bind AutoUse}" Command="{x:Bind ActivateCommand}" Visibility="{x:Bind CanActivate, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind ViewModel.StorageLine, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
