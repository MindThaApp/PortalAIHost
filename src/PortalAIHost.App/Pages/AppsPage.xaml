<Page
    x:Class="PortalAIHost.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel.KeyboardAccelerators>
                <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoKey" />
            </StackPanel.KeyboardAccelerators>
            <TextBlock x:Uid="AppsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasUndo, Mode=OneWay}" Message="{x:Bind ViewModel.RevokedLine, Mode=OneWay}" Severity="Informational" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Uid="AppsUndo" Command="{x:Bind ViewModel.UndoCommand}" AutomationProperties.Name="{x:Bind ViewModel.UndoLabel, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <TextBlock Text="{x:Bind ViewModel.ErrorLine, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay}">
                <TextBlock x:Uid="AppsWaitingHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Pending}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingRowViewModel">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind IdentityText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Uid="AppAllow" AutomationProperties.Name="{x:Bind AutoAllow}" Command="{x:Bind AllowCommand}" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Uid="AppDeny" AutomationProperties.Name="{x:Bind AutoDeny}" Command="{x:Bind DenyCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock x:Uid="AppsApprovedHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="AppsNone" Visibility="{x:Bind ViewModel.NoClients, Mode=OneWay}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Clients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientRowViewModel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind PausedBadge}" Visibility="{x:Bind IsPaused, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AddedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind LastUsedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind TodayText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind PausedHint}" Visibility="{x:Bind IsPaused, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="AppRevoke" AutomationProperties.Name="{x:Bind AutoRevoke}" Command="{x:Bind RevokeCommand}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                                    <ComboBox x:Uid="AppPriority" MinWidth="140" ItemsSource="{x:Bind PriorityOptions}" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind PriorityAutomation}" />
                                    <Button Content="{x:Bind PauseLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind PauseAutomation, Mode=OneWay}" Command="{x:Bind TogglePauseCommand}" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
