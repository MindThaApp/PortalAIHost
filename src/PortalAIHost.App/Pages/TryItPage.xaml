<Page
    x:Class="PortalAIHost.App.Pages.TryItPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels"
    xmlns:ctl="using:PortalAIHost.App.Controls">
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="TryItTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Grid.Column="1" x:Uid="TryItClear" Command="{x:Bind ViewModel.ClearCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Uid="TryItIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- A few prompts to start with. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowSuggestions, Mode=OneWay}">
                <TextBlock x:Uid="TryItSuggestLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{x:Bind}" Click="OnSuggestion" Margin="0,0,0,8" HorizontalContentAlignment="Left" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The conversation. Kept in memory only. -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Messages}" Visibility="{x:Bind ViewModel.HasMessages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TryItMessage">
                        <StackPanel Spacing="6" Margin="0,0,0,12">
                            <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Right"
                                    Visibility="{x:Bind IsUser}">
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Border>
                            <StackPanel Spacing="6" Visibility="{x:Bind IsAssistant}">
                                <Expander x:Uid="TryItThinking" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Visibility="{x:Bind HasThinking, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Thinking, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Expander>
                                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Left">
                                    <ctl:MarkdownView x:Uid="TryItReply" Markdown="{x:Bind Text, Mode=OneWay}" MinHeight="24" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.Stats, Mode=OneWay}"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasStats, Mode=OneWay}" />

            <TextBox
                x:Uid="TryItPrompt"
                Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="72">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendAccelerator" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="TryItSend" Command="{x:Bind ViewModel.SendCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Uid="TryItStop" Command="{x:Bind ViewModel.StopCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
