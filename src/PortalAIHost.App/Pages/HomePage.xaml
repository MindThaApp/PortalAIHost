<Page
    x:Class="PortalAIHost.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortalAIHost.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="HomeTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar
                x:Uid="HomeSafeModeBar"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.SafeMode, Mode=OneWay}" />
            <InfoBar
                x:Uid="HomeStoreProblemBar"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.StoreProblem, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasStoreProblem, Mode=OneWay}" />

            <!-- Health: one line when all is well, the checks and one-click fixes behind the expander. -->
            <Expander x:Uid="HomeHealthExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.Health.HasReport, Mode=OneWay}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  Visibility="{x:Bind ViewModel.Health.AllGood, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  Visibility="{x:Bind ViewModel.Health.HasWarn, Mode=OneWay}" />
                        <FontIcon Glyph="&#xEA39;" FontSize="20" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  Visibility="{x:Bind ViewModel.Health.HasFail, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Health.Summary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Health.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HealthRow">
                                <Grid ColumnSpacing="12" Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <FontIcon x:Uid="HealthIconOk" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  Visibility="{x:Bind IsOk}" />
                                        <FontIcon x:Uid="HealthIconWarn" Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Visibility="{x:Bind IsWarn}" />
                                        <FontIcon x:Uid="HealthIconFail" Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind IsFail}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Uid="HealthWordOk" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsOk}" />
                                            <TextBlock x:Uid="HealthWordWarn" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsWarn}" />
                                            <TextBlock x:Uid="HealthWordFail" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsFail}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{x:Bind FixLabel}" Command="{x:Bind FixCommand}"
                                            Visibility="{x:Bind HasFix}" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <InfoBar x:Uid="HealthFixErrorBar" Severity="Error" Message="{x:Bind ViewModel.Health.Error, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.Health.HasError, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="HealthCheckAgainButton" Command="{x:Bind ViewModel.Health.CheckAgainCommand}"
                                IsEnabled="{x:Bind ViewModel.Health.CanCheck, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Health.Busy, Mode=OneWay}" Width="20" Height="20"
                                      Visibility="{x:Bind ViewModel.Health.Busy, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- A new device paired, or one connected from away. -->
            <InfoBar Severity="Informational" IsClosable="True" Message="{x:Bind ViewModel.Shell.DeviceNotice, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.Shell.HasDeviceNotice, Mode=OneWay}" CloseButtonClick="OnDeviceNoticeClosed"
                     AutomationProperties.LiveSetting="Polite" />

            <!-- Client mode: the home PC, how it is reached, and a way back. -->
            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.Link.IsClientMode, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE839;" FontSize="20" />
                        <TextBlock Text="{x:Bind ViewModel.Link.ChipText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Link.DetailText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.Link.LastSeenText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <InfoBar Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.Link.AttentionText, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.Link.NeedsAttention, Mode=OneWay}" />
                    <InfoBar Severity="Informational" IsClosable="False" Message="{x:Bind ViewModel.Link.UsingLaptopText, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.Link.UsingLaptopModel, Mode=OneWay}" />
                    <TextBlock x:Uid="HomeClientEmpty" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.Link.HideLocalModel, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="HomeChangePc" Click="OnOpenSettings">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="16" />
                                <TextBlock x:Uid="HomeChangePcText" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="HomeRunHere" Command="{x:Bind ViewModel.Link.RunHereCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F8;" FontSize="16" />
                                <TextBlock x:Uid="HomeRunHereText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The host is not running. -->
            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.NoHost, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Uid="HomeStartButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartHostCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StartMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Running, no model yet: guided first-run panel. -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowOnboarding, Mode=OneWay}">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="HomeWelcomeTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="HomeWelcomeBody" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Uid="HomeCatalogueBar"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.CatalogueUnavailable, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="HomeTryAgainButton" Command="{x:Bind ViewModel.TryAgainCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.HasRecommendation, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="HomeRecommendedLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.RecName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.RecSize, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RecReason, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar
                            x:Uid="HomeNoSpaceBar"
                            Severity="Error"
                            IsClosable="False"
                            Message="{x:Bind ViewModel.SpaceLine, Mode=OneWay}"
                            IsOpen="{x:Bind ViewModel.NotEnoughSpace, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button x:Uid="HomeChangeFolderButton" Click="OnOpenSettings" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}">
                            <ProgressBar Value="{x:Bind ViewModel.Percent, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.NoteText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNote, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Uid="HomeDownloadButton"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="{x:Bind ViewModel.RecAutoDownload, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DownloadCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}" />
                            <HyperlinkButton x:Uid="HomeSeeAllModelsLink" Click="OnSeeModels" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <HyperlinkButton
                    x:Uid="HomeSeeAllModelsLink2"
                    Click="OnSeeModels"
                    Visibility="{x:Bind ViewModel.CatalogueUnavailable, Mode=OneWay}" />
            </StackPanel>

            <!-- Running with a model: status card. -->
            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.ShowInstalled, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="HomeActiveModelLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ModelLine, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.IdleLine, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="HomeAppsLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AppsLine, Mode=OneWay}" TextWrapping="Wrap" />
                        <HyperlinkButton x:Uid="HomeSeeAppsLink" Click="OnSeeApps" Padding="0,2" />
                    </StackPanel>
                    <Button x:Uid="HomeTryItButton" Click="OnTryIt" HorizontalAlignment="Left"
                            IsEnabled="{x:Bind ViewModel.CanTryIt, Mode=OneWay}" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="HomeRequestsLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.QueueLine, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Live activity, meters, Unload/Load and Today. Reads the host every 1.5 s only while this page is visible. -->
            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.ShowInstalled, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="HomeLiveTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Live.ActivityTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Live.SpeedLine, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Live.HasSpeed, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Live.QueueLine, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Live.HasMemory, Mode=OneWay}">
                        <TextBlock x:Uid="HomeRamLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Value="{x:Bind ViewModel.Live.RamPercent, Mode=OneWay}" Maximum="100"
                                     AutomationProperties.Name="{x:Bind ViewModel.Live.RamName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Live.RamLine, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Live.HasVram, Mode=OneWay}">
                        <TextBlock x:Uid="HomeVramLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Value="{x:Bind ViewModel.Live.VramPercent, Mode=OneWay}" Maximum="100"
                                     AutomationProperties.Name="{x:Bind ViewModel.Live.VramName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Live.VramLine, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="HomeUnloadButton" Command="{x:Bind ViewModel.Live.UnloadCommand}" Visibility="{x:Bind ViewModel.Live.CanUnload, Mode=OneWay}" />
                        <Button x:Uid="HomeLoadButton" Command="{x:Bind ViewModel.Live.LoadCommand}" Visibility="{x:Bind ViewModel.Live.CanLoad, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Live.ActionPending, Mode=OneWay}" Width="20" Height="20"
                                      Visibility="{x:Bind ViewModel.Live.ActionPending, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Live.PendingText, Mode=OneWay}" VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.Live.ActionPending, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar x:Uid="HomeActionErrorBar" Severity="Error" Message="{x:Bind ViewModel.Live.ActionError, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.Live.HasActionError, Mode=TwoWay}" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HomeTodayLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Live.TodayEmptyText, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Live.NoToday, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Live.Today}" Visibility="{x:Bind ViewModel.Live.HasToday, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodayRow">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.UpgradeAvailable, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="HomeUpgradeText" TextWrapping="Wrap" />
                    <Button x:Uid="HomeSeeModelsButton" Click="OnSeeModels" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
