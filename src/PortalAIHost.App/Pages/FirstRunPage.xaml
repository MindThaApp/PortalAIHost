<Page
    x:Class="PortalAIHost.App.Pages.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="48,32" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="FirstRunTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StepDots, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.StepLine, Mode=OneWay}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.OnCheck, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="FirstRunCheckHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MemoryLine, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.GraphicsLine, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CoresLine, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DiskLine, Mode=OneWay}" />
                    <Button x:Uid="FirstRunNext" Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.OnModel, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="FirstRunModelHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ModelReason, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ModelSize, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ExistingLine, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button x:Uid="FirstRunDownload" Command="{x:Bind ViewModel.DownloadCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.OnDownload, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="FirstRunDownloadHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind ViewModel.Percent, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button x:Uid="FirstRunRetry" Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.DownloadFailed, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.OnStartup, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="FirstRunStartupHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Uid="FirstRunStartWithWindows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <Button x:Uid="FirstRunFinish" Command="{x:Bind ViewModel.FinishCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <HyperlinkButton x:Uid="FirstRunSkip" Command="{x:Bind ViewModel.SkipCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
